{
  "name": "switch-service",
  "version": "1.0.0",
  "private": true,
  "description": "Selects a payout channel from sliding-window performance. Reads the outcome event.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrateCli.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "pact:consumer": "vitest run test/pact/outcome.message.consumer.pact.test.ts",
    "pact:provider": "vitest run test/pact/switch.provider.pact.test.ts",
    "pact:publish": "node scripts/pact-publish.mjs",
    "pact:can-i-deploy": "node scripts/can-i-deploy.mjs",
    "pact:record-deployment": "node scripts/record-deployment.mjs",
    "console:build": "vite build console",
    "console:dev": "vite console"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.5"
  }
}
