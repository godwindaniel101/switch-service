# Copy this file to .env for local work.
NODE_ENV=development
PORT=4011
LOG_LEVEL=info

# Postgres. This service owns switch_db. It reads no other database.
DATABASE_URL=postgres://pact:pact@localhost:5434/switch_db
DATABASE_READ_URL=postgres://pact:pact@localhost:5434/switch_db
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Redis. This service needs two clients: one for commands and one for the
# blocking stream read. See the service-data-layer skill.
REDIS_URL=redis://localhost:6380
OUTCOME_STREAM=txn.outcomes
CONSUMER_GROUP=switch-consumers
DEAD_LETTER_STREAM=txn.outcomes.dead
MAX_DELIVERIES=5
CLAIM_MIN_IDLE_MS=30000
PROCESSED_TTL_SECONDS=600

# The budget for the Redis reads inside one routing decision. When the budget
# runs out, the service routes in degraded mode. It never fails the payout.
METRICS_TIMEOUT_MS=300

# The sliding window.
WINDOW_MS=60000
BUCKET_MS=5000
MAX_SAMPLES_PER_BUCKET=200
MIN_SAMPLES=20
LATENCY_CEILING_MS=2000

# The score weights. They MUST add to 1.0, and the service refuses to start
# if they do not.
WEIGHT_SUCCESS=0.6
WEIGHT_LATENCY=0.3
WEIGHT_COST=0.1

# The circuit breaker.
BREAKER_FAILURE_RATE_THRESHOLD=0.5
BREAKER_OPEN_MS=30000
BREAKER_PROBES_TO_CLOSE=3

# Exploration keeps a recovered channel measurable.
EXPLORATION_RATE=0.1

# The optimistic defaults of a cold channel.
COLD_START_SUCCESS_RATE=0.8
COLD_START_LATENCY_SCORE=0.5

# The Pact Broker. Used by the publish and verify scripts, and by the read-only
# contract panel of the console.
PACT_BROKER_BASE_URL=http://localhost:9292
PACT_BROKER_USERNAME=pact
PACT_BROKER_PASSWORD=pact
